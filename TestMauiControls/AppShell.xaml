<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TestMauiControls.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TestMauiControls"
    xmlns:viewModels="clr-namespace:TestMauiControls.ViewModels"
    Title="TestMauiControls"
    x:DataType="viewModels:AppShellViewModel"
    FlyoutIcon="{Binding FlyoutIcon}">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
    <ShellContent
        Title="Menu"
        ContentTemplate="{DataTemplate local:MenuPage}"
        Route="MenuPage" />

</Shell>
