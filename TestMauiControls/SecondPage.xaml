<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TestMauiControls.ViewModels"
             x:Class="TestMauiControls.SecondPage"
             x:DataType="viewModels:SecondPageViewModel"
             Title="Second page">
    <ContentPage.Content>
        <Grid ColumnDefinitions="*,*" RowDefinitions="60,60">
        <Button Grid.Row="0" Grid.Column="0" Text="Activate icon" Command="{Binding SetIconStateCommand}"
                CommandParameter="true"/>
        <Button Grid.Row="0" Grid.Column="1" Text="Deactivate icon" Command="{Binding SetIconStateCommand}"
                CommandParameter="false"/>
        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Go Back" Command="{Binding GoBackCommand}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>