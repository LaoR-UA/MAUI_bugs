<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:testMauiControls="clr-namespace:TestMauiControls"
             x:Class="TestMauiControls.MainPage" 
             x:DataType="testMauiControls:MainPageViewModel">

    
    <CollectionView ItemSizingStrategy="MeasureFirstItem" HeightRequest="700"
                    ItemsSource="{Binding Items}">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="testMauiControls:ItemViewModel">
                <testMauiControls:ItemControl HeightRequest="180"/>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    
</ContentPage>
