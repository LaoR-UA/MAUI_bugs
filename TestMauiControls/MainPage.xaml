<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:testMauiControls="clr-namespace:TestMauiControls"
             x:Class="TestMauiControls.MainPage">

    <ContentPage.Resources>
        <DataTemplate x:Key="SettingItemTemplate">
            <Grid ColumnDefinitions="*, 15" HeightRequest="50" Margin="0" Padding="0"
                  HorizontalOptions="Fill" Background="Green" ColumnSpacing="0" RowSpacing="0"
                  VerticalOptions="Fill">
                <Label Text="{Binding .}" HorizontalOptions="Center" Grid.Column="0" VerticalOptions="Center"/>
                <Label Text=">" HorizontalOptions="Start" VerticalOptions="Center" Grid.Column="1" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <testMauiControls:EntryRaw Grid.Row="0" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"
               VerticalOptions="Center" HorizontalOptions="Fill" HorizontalTextAlignment="Center"
               Placeholder="Type something here..."
               ReturnType="Done" ClearButtonVisibility="WhileEditing" Keyboard="Plain"
               MaxLength="100" IsReadOnly="False"/>
        <Button Grid.Row="1" Text="Save" VerticalOptions="End" HeightRequest="{OnIdiom 44, Desktop=60}"/>
    </Grid>

</ContentPage>
