<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:testMauiControls="clr-namespace:TestMauiControls"
             x:Class="TestMauiControls.MainPage"
             x:DataType="testMauiControls:MainPageViewModel">
    
        <Grid RowDefinitions="*, 10">
            <CarouselView Grid.Row="0" ItemsSource="{Binding Labels}"
                      IndicatorView="CarouselIndicator">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type x:String}">
                        <Border WidthRequest="300" Background="Red">
                            <Label Text="{Binding .}" VerticalOptions="Center"
                                   HorizontalOptions="Center" FontSize="30"/>
                        </Border>
                </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <IndicatorView Grid.Row="1" x:Name="CarouselIndicator"
                       IndicatorColor="{StaticResource Gray400}"
                       SelectedIndicatorColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                       HorizontalOptions="Center"/>
        </Grid>
    
</ContentPage>
